<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：替换 <你的用户名> <你的固定出口IP> <机房如EWR>，脚本路径按实际位置修改 -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.net-check</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>/Users/&lt;你的用户名&gt;/ai-network-setup-skill/scripts/net-check.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>EXPECTED_IP</key><string>&lt;你的固定出口IP&gt;</string>
    <key>EXPECTED_COLO</key><string>&lt;机房如EWR&gt;</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
  </dict>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>36</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/&lt;你的用户名&gt;/Library/Logs/net-check.log</string>
  <key>StandardErrorPath</key><string>/Users/&lt;你的用户名&gt;/Library/Logs/net-check.log</string>
</dict></plist>
